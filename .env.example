# Copy to .env and fill in. Never commit .env.

# --- LLM: grounded explanations + optional query paraphrasing ----------------
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise OpenAI if OPENAI_API_KEY is set.
LLM_PROVIDER=auto               # auto | openai | anthropic
SYNTHESIS_ENABLED=true
QUERY_EXPANSION_MODE=rules      # none | rules | llm

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini       # e.g. gpt-5.5 for higher quality (slower, pricier)
OPENAI_REASONING_EFFORT=        # optional for reasoning models: low | medium | high

# Anthropic (alternative)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
CLAUDE_FALLBACKS=default        # server-side refusal fallback; empty to disable

# --- Paths --------------------------------------------------------------------
PAPERS_DIR=./papers             # folder scanned recursively for *.pdf
DATA_DIR=./data                 # index, caches (safe to delete = full rebuild)

# --- Embeddings ---------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | medcpt | openai
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5      # ignored for medcpt
EMBEDDING_DEVICE=auto                      # auto | cpu | cuda | mps
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_PROVIDER=openai uses OPENAI_API_KEY above, e.g.
# EMBEDDING_MODEL=text-embedding-3-large   # (requires a full rebuild)

# --- Reranker -------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Ingestion ------------------------------------------------------------------
OCR_ENABLED=true                # needs the tesseract binary (brew install tesseract)
OCR_MIN_CHARS_PER_PAGE=80
INGEST_WORKERS=0                # 0 = min(4, CPU count - 1)
INGEST_TIMEOUT_S=300            # per-PDF processing limit
CHUNK_TARGET_WORDS=220
CHUNK_OVERLAP_WORDS=50
CROSSREF_ENABLED=false          # look up title/authors/year by DOI (sends DOIs to api.crossref.org)
CROSSREF_MAILTO=

# --- Service --------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:8000   # used for "open PDF" links
LOG_LEVEL=INFO
LOG_FORMAT=console              # console | json
